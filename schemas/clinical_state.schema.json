{
  "$defs": {
    "Differential": {
      "properties": {
        "most_likely": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DifferentialItem"
          },
          "title": "Most Likely",
          "type": "array"
        },
        "must_not_miss": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DifferentialItem"
          },
          "title": "Must Not Miss",
          "type": "array"
        }
      },
      "title": "Differential",
      "type": "object"
    },
    "DifferentialItem": {
      "properties": {
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "discriminators_pending": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Discriminators Pending",
          "type": "array"
        },
        "evidence_against": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence Against",
          "type": "array"
        },
        "evidence_for": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence For",
          "type": "array"
        },
        "guideline_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Guideline Refs",
          "type": "array"
        },
        "probability": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "status": {
          "default": "not_excluded",
          "pattern": "^(not_excluded|excluded|confirmed_pending)$",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "condition"
      ],
      "title": "DifferentialItem",
      "type": "object"
    },
    "EscalationLevel": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "title": "EscalationLevel",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "CONSENT",
        "IDENTITY_PROXY",
        "CHIEF_COMPLAINT",
        "RED_FLAG",
        "HPI",
        "PMH_MED",
        "SPECIALTY",
        "DIFFERENTIAL",
        "EVIDENCE",
        "VERIFY",
        "DOCTOR_REVIEW",
        "SUMMARY",
        "ESCALATION",
        "PSYCH_RISK",
        "DEGRADED",
        "END"
      ],
      "title": "Phase",
      "type": "string"
    },
    "SourceRef": {
      "description": "硬规则5: 任何临床字段必须可溯源。",
      "properties": {
        "asr_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asr Confidence"
        },
        "kind": {
          "pattern": "^(utterance|ehr|doctor_input|tool)$",
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Symptom": {
      "properties": {
        "concept_id": {
          "title": "Concept Id",
          "type": "string"
        },
        "onset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Onset"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "secondhand": {
          "default": false,
          "title": "Secondhand",
          "type": "boolean"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SymptomStatus"
        }
      },
      "required": [
        "concept_id",
        "raw_text",
        "status",
        "sources"
      ],
      "title": "Symptom",
      "type": "object"
    },
    "SymptomStatus": {
      "enum": [
        "present",
        "denied",
        "probably_denied",
        "uncertain",
        "unknown"
      ],
      "title": "SymptomStatus",
      "type": "string"
    }
  },
  "properties": {
    "allergies": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Allergies",
      "type": "array"
    },
    "answered_slots": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Answered Slots",
      "type": "object"
    },
    "asked_slots": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Asked Slots",
      "type": "array"
    },
    "chief_complaints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Chief Complaints",
      "type": "array"
    },
    "contradictions": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "degraded_mode": {
      "default": "L0",
      "title": "Degraded Mode",
      "type": "string"
    },
    "differential": {
      "$ref": "#/$defs/Differential",
      "default": {
        "most_likely": [],
        "must_not_miss": []
      }
    },
    "encounter_id": {
      "title": "Encounter Id",
      "type": "string"
    },
    "escalation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EscalationLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "medications": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Medications",
      "type": "array"
    },
    "missing_slots": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Slots",
      "type": "array"
    },
    "phase": {
      "$ref": "#/$defs/Phase",
      "default": "CONSENT"
    },
    "population": {
      "default": "adult",
      "title": "Population",
      "type": "string"
    },
    "pregnancy": {
      "default": "unknown",
      "title": "Pregnancy",
      "type": "string"
    },
    "question_count": {
      "default": 0,
      "title": "Question Count",
      "type": "integer"
    },
    "red_flag_hits": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Red Flag Hits",
      "type": "array"
    },
    "reporter": {
      "default": "self",
      "title": "Reporter",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "symptoms": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Symptom"
      },
      "title": "Symptoms",
      "type": "array"
    }
  },
  "required": [
    "encounter_id"
  ],
  "title": "ClinicalState",
  "type": "object"
}
