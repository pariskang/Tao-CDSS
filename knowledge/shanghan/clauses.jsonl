{"clause_id": "SHL_001", "no": 1, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳之为病,脉浮,头项强痛而恶寒。"}
{"clause_id": "SHL_002", "no": 2, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,发热,汗出,恶风,脉缓者,名为中风。"}
{"clause_id": "SHL_003", "no": 3, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,或已发热,或未发热,必恶寒,体痛,呕逆,脉阴阳俱紧者,名为伤寒。"}
{"clause_id": "SHL_012", "no": 12, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳中风,阳浮而阴弱,啬啬恶寒,淅淅恶风,翕翕发热,鼻鸣干呕者,桂枝汤主之。"}
{"clause_id": "SHL_013", "no": 13, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,头痛,发热,汗出,恶风者,桂枝汤主之。"}
{"clause_id": "SHL_014", "no": 14, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,项背强几几,反汗出恶风者,桂枝加葛根汤主之。"}
{"clause_id": "SHL_017", "no": 17, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "酒客病,不可与桂枝汤,得之则呕,以酒客不喜甘故也。"}
{"clause_id": "SHL_020", "no": 20, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,发汗,遂漏不止,其人恶风,小便难,四肢微急,难以屈伸者,桂枝加附子汤主之。"}
{"clause_id": "SHL_026", "no": 26, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "服桂枝汤,大汗出后,大烦渴不解,脉洪大者,白虎加人参汤主之。"}
{"clause_id": "SHL_031", "no": 31, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,项背强几几,无汗恶风,葛根汤主之。"}
{"clause_id": "SHL_032", "no": 32, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳与阳明合病者,必自下利,葛根汤主之。"}
{"clause_id": "SHL_034", "no": 34, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,桂枝证,医反下之,利遂不止,脉促者,表未解也;喘而汗出者,葛根黄芩黄连汤主之。"}
{"clause_id": "SHL_035", "no": 35, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,头痛发热,身疼腰痛,骨节疼痛,恶风,无汗而喘者,麻黄汤主之。"}
{"clause_id": "SHL_040", "no": 40, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "伤寒表不解,心下有水气,干呕,发热而咳,或渴,或利,或噎,或小便不利,少腹满,或喘者,小青龙汤主之。"}
{"clause_id": "SHL_071", "no": 71, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "太阳病,发汗后,大汗出,胃中干,烦躁不得眠,欲得饮水者,少少与饮之,令胃气和则愈;若脉浮,小便不利,微热消渴者,五苓散主之。"}
{"clause_id": "SHL_096", "no": 96, "channel": "shaoyang", "section": "辨太阳病脉证并治", "text": "伤寒五六日,中风,往来寒热,胸胁苦满,嘿嘿不欲饮食,心烦喜呕者,小柴胡汤主之。"}
{"clause_id": "SHL_154", "no": 154, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "心下痞,按之濡,其脉关上浮者,大黄黄连泻心汤主之。"}
{"clause_id": "SHL_177", "no": 177, "channel": "taiyang", "section": "辨太阳病脉证并治", "text": "伤寒,脉结代,心动悸,炙甘草汤主之。"}
{"clause_id": "SHL_180", "no": 180, "channel": "yangming", "section": "辨阳明病脉证并治", "text": "阳明之为病,胃家实是也。"}
{"clause_id": "SHL_208", "no": 208, "channel": "yangming", "section": "辨阳明病脉证并治", "text": "阳明病,脉迟,虽汗出,不恶寒者,其身必重,短气,腹满而喘,有潮热者,此外欲解,可攻里也,大承气汤主之。"}
{"clause_id": "SHL_263", "no": 263, "channel": "shaoyang", "section": "辨少阳病脉证并治", "text": "少阳之为病,口苦,咽干,目眩也。"}
{"clause_id": "SHL_273", "no": 273, "channel": "taiyin", "section": "辨太阴病脉证并治", "text": "太阴之为病,腹满而吐,食不下,自利益甚,时腹自痛,若下之,必胸下结硬。"}
{"clause_id": "SHL_281", "no": 281, "channel": "shaoyin", "section": "辨少阴病脉证并治", "text": "少阴之为病,脉微细,但欲寐也。"}
{"clause_id": "SHL_301", "no": 301, "channel": "shaoyin", "section": "辨少阴病脉证并治", "text": "少阴病,始得之,反发热,脉沉者,麻黄细辛附子汤主之。"}
{"clause_id": "SHL_326", "no": 326, "channel": "jueyin", "section": "辨厥阴病脉证并治", "text": "厥阴之为病,消渴,气上撞心,心中疼热,饥而不欲食,食则吐蛔,下之利不止。"}
{"clause_id": "SHL_379", "no": 379, "channel": "shaoyang", "section": "辨厥阴病脉证并治", "text": "呕而发热者,小柴胡汤主之。"}
